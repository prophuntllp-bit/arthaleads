# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/realestate_crm
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/realestate_crm
MONGO_URI=mongodb://localhost:27017/realestate_crm

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: run  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_very_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ── Field encryption (Automation.accessToken / userToken) ────────────────────
# Required in production — must be exactly 64 hex characters (32 bytes).
# Generate one: run  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, saving any Facebook automation connection will fail.
CRYPTO_KEY=change_this_to_a_64_character_hex_string_in_production

# ── reCAPTCHA v3 (Signup / OTP send) ──────────────────────────────────────────
# Get keys at https://google.com/recaptcha/admin/create (Score based / v3).
# Site key goes in frontend/.env.local as VITE_RECAPTCHA_SITE_KEY (public).
# Secret key goes here — never expose it client-side.
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_URLS=http://localhost:3000,http://localhost:5173

# ── Facebook Webhook ──────────────────────────────────────────────────────────
FB_VERIFY_TOKEN=my_facebook_verify_token
FB_PAGE_ACCESS_TOKEN=your_page_access_token
FB_APP_ID=your_meta_app_id
FB_APP_SECRET=your_meta_app_secret
FB_REDIRECT_URI=http://localhost:5000/api/automations/facebook/callback
FRONTEND_URL=http://localhost:3000

# ── WhatsApp Embedded Signup ──────────────────────────────────────────────────
# A SEPARATE Meta app from FB_APP_ID above (that one is the Lead Ads app) — this
# is the "Arthaleads Messaging" app tenants connect their own WhatsApp through.
# WA_APP_ID/WA_APP_SECRET: that app's own App ID/Secret.
# WA_ES_CONFIG_ID: the config_id from Facebook Login for Business Configuration
#   (the v4 "Embedded Signup Builder" in the app dashboard).
# WA_WEBHOOK_VERIFY_TOKEN: app-level, set once in the Meta dashboard's WhatsApp
#   → Configuration → Webhook — distinct from each org's own webhookVerifyToken
#   used by the manual/Advanced connect path.
# WA_CREDIT_LINE_ID: left unset until Arthaleads has a Meta credit line to
#   share (see docs/whatsapp-embedded-signup-plan.md) — every embedded-signup
#   connection quietly falls back to the tenant's own card until it is set.
WA_APP_ID=your_whatsapp_app_id
WA_APP_SECRET=your_whatsapp_app_secret
WA_ES_CONFIG_ID=your_embedded_signup_config_id
WA_WEBHOOK_VERIFY_TOKEN=a_random_string_you_choose
WA_CREDIT_LINE_ID=

# ── Email / Resend (HTTP API — no SMTP, works on Railway) ────────────────────
# Sign up free at resend.com → API Keys → Create API Key
RESEND_API_KEY=re_your_api_key_here
# Once you verify arthaleads.com domain in Resend, change this to:
# SMTP_FROM=Arthaleads <noreply@arthaleads.com>
# Until then, Resend sandbox only sends to your own verified email:
SMTP_FROM=Arthaleads <onboarding@resend.dev>

# ── Sentry (error monitoring) ────────────────────────────────────────────────
# Get DSN from sentry.io → your project → Settings → Client Keys
SENTRY_DSN=https://xxxx@oxxxx.ingest.us.sentry.io/xxxx

# ── Backup ───────────────────────────────────────────────────────────────────
# Email address that receives the daily gzipped DB backup
BACKUP_EMAIL=your@email.com

# ── Cloudinary (logo CDN) ────────────────────────────────────────────────────
# Sign up free at cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI ────────────────────────────────────────────────────────────────────────
# Powers AI WhatsApp drafts, the inbox bot, template generation, the help
# assistant and call transcription. Without it those endpoints return 503.
OPENAI_API_KEY=sk-your_openai_key_here

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max requests per 15 minutes per IP (for auth endpoints)
RATE_LIMIT_AUTH=20
# Max requests per 15 minutes per IP, for signed-OUT traffic
RATE_LIMIT_GENERAL=200
# Max requests per 15 minutes for a signed-IN user, keyed by their own id so an
# office does not share one budget
RATE_LIMIT_USER=1500

# ── Android app version check (private APK distribution) ─────────────────────
# The current release is declared in backend/constants/appRelease.js and moves
# with the commit that bumps mobile/pubspec.yaml — normally you set NOTHING here.
# These exist only as an emergency override (e.g. fixing a broken download link
# without waiting for a deploy). Any value set here wins over appRelease.js.
# ANDROID_LATEST_BUILD=
# ANDROID_LATEST_VERSION=
# ANDROID_MIN_BUILD=
# ANDROID_APK_URL=
# ANDROID_RELEASE_NOTES=
