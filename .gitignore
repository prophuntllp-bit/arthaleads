node_modules/
backend/node_modules/
frontend/node_modules/

dist/
build/
frontend/dist/
backend/dist/

.env
backend/.env
frontend/.env
# Local overrides. Nothing here is currently secret — Firebase web config and
# the reCAPTCHA *site* key are public by design — but the rule exists so the
# next value dropped in this file does not land in a public repo.
*.env.local

.vite/
.codex-logs/

Thumbs.db
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vercel

# Capacitor Android project — committed; android/.gitignore handles internal exclusions.
# google-services.json is injected by CI from GOOGLE_SERVICES_JSON secret (never committed).
frontend/android/app/google-services.json

# Same pattern for the Flutter mobile app.
mobile/android/app/google-services.json

# Android release keystore — store privately, add base64 as KEYSTORE_BASE64 GitHub secret
android-release/
frontend/android/app/release.keystore
*.jks

# Python bytecode
__pycache__/
*.pyc
*.pyo

# ZIP artifacts — generate locally, never commit
*.zip
# ...except the WordPress plugin the marketing site hands out. The blanket rule
# above is why /arthaleads-integration.zip served an 11KB SPA fallback instead
# of a download: the file was on every developer's disk and in the Capacitor
# build assets, so it looked present everywhere except the one place Vercel
# serves from.
!frontend/public/arthaleads-integration.zip

# Claude Code worktrees — transient scratch checkouts. These were committed as
# bare gitlinks with no .gitmodules entry, so every CI checkout emitted
# "fatal: No url found for submodule path '.claude/worktrees/...'".
# Shared project config (.claude/settings.json, .claude/skills/) stays tracked.
.claude/worktrees/
